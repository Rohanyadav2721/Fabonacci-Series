        "#fibonacci series\n",
        "num=int(input(\"enter number:\"))\n",
        "\n",
        "a=0\n",
        "b=1\n",
        "print(a,b,end=\" \")\n",
        "\n",
        "for i in range(num-2):\n",
        "    c=a+b\n",
        "    print(c,end=\" \")\n",
        "    a=b\n",
        "    b=c"
      ]
